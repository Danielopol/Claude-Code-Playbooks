{
  "name": "claude-code-playbooks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-index.mjs",
    "build": "next build",
    "index": "node scripts/build-index.mjs",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build && node scripts/cloudflare-assets.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:preview": "opennextjs-cloudflare preview --port 8787",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "blog:add": "npx tsx src/scripts/update-blog.ts add",
    "blog:sync": "npx tsx src/scripts/update-blog.ts sync",
    "license:audit": "node scripts/audit-playbook-licenses.mjs",
    "plugin:build": "node scripts/build-chatgpt-plugin.mjs",
    "pipeline:verify": "node scripts/pipeline/verify-sources.mjs",
    "pipeline:test": "node scripts/pipeline/selftest.mjs",
    "pipeline:discover": "node scripts/pipeline/discover.mjs",
    "pipeline:harvest": "node scripts/pipeline/harvest.mjs",
    "pipeline:report": "node scripts/pipeline/report.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@next/mdx": "^15.5.29",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^15.5.29",
    "posthog-js": "^1.449.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.8.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
